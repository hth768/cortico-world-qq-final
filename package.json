{
  "name": "cortico-world-qq-final",
  "version": "0.6.42",
  "description": "Cortico World 扩展：QQ（OneBot v11 / NapCat）适配器。",
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "dist",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "ENV_PROMPT.md",
    "asr_sidecar.py",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hth768/cortico-world-qq-final.git"
  },
  "homepage": "https://github.com/hth768/cortico-world-qq-final#readme",
  "bugs": {
    "url": "https://github.com/hth768/cortico-world-qq-final/issues"
  },
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "qq",
    "onebot",
    "napcat"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "label": "QQ_bot",
    "tags": [
      "im",
      "qq",
      "external-setup"
    ],
    "webUiClient": "dist/console.js",
    "webUiStyle": "dist/console.css",
    "describe": "describe.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:console": "node scripts/build-console.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test": "node --test tests/normalize.test.ts tests/config.test.ts tests/security.test.ts tests/forward.test.ts tests/image-store.test.ts tests/file-store.test.ts tests/video.test.ts"
  },
  "dependencies": {
    "silk-wasm": "^3.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
